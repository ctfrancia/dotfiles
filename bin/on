#!/bin/zsh

if [ -z "$1" ]; then
    echo "need a name for the file"
    exit 1
fi

file_name=$(echo "$1" | tr ' ' '-')
formatted_file_name=$(date "+%Y-%m-%d")_${file_name}.md
# cd "/Users/ctfrancia/Library/Mobile\ Documents/iCloud-md-obsidian/Documents/thoughts/" || exit
cd "/Users/ctfrancia/Library/Mobile Documents/iCloud~md~obsidian/Documents/thoughts" || exit
touch "inbox/${formatted_file_name}"
nvim "inbox/${formatted_file_name}"
